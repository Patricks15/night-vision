// Navy ~ 0.2-lite
// <ds>Draw bounding box tool [Shift+Click]</ds>

import { draw } from "svelte/transition"

[OVERLAY name=BoxTool, ctx=Canvas, verion=1.0.1, author=GPT4]

let box = null
let pressed = false
let state = 'idle'

init() {
    box = null
}

draw(ctx) {
    if (box) {
        box.draw(ctx)
    }
}


document.getElementById('idBtnToolBox').addEventListener('click', () => {
    pressed = true
});

// disableBtns = ["idBtnToolCursor", "idBtnToolBox", "idBtnToolRange", "idBtnToolFibo"]
function disableShift() {
    pressed = false;
}

disableBtns = ["idBtnToolCursor", "idBtnToolRange", "idBtnToolFibo", "idBtnToolLine", "idBtnToolTrade"]  // 
disableBtns.forEach(id => {
    document.getElementById(id)?.addEventListener('click', disableShift);
});



mousedown(event) {
    
    const layout = $core.layout

    if (state === 'idle' && pressed) {
        if (event.button !== 0) return // only left click allowed

        // Create the first pin
        const i = $core.cursor.ti
        const v = layout.y2value(event.layerY)

        const data = {
            type: 'segment',
            p1: [i, v],
            p2: [i, v],
            uuid: 'single-line'
        }

        box = new $lib.Box($core, data, true)
        state = 'drawing'

    } else if (state === 'drawing') {
        state = 'finished'

    } else if (state === 'finished' && event.button === 2) {
        // and hover over Line
        if (box.hover) {
            state = 'idle'
            box = null
        }
    }

    $events.emitSpec('chart', 'update-layout')
    if (box) box.mousedown(event)
}

mouseup(event) {
    if (box) box.mouseup(event)
}

mousemove(event) {

    if (box) {
        box.mousemove(event)
    }

    if (state === 'drawing') {
        const layout = $core.layout
        box.data.p2 = [
            $core.cursor.ti,
            layout.y2value(event.layerY)
        ]
    }
}

// Disable legend by returning null
legend() => null
