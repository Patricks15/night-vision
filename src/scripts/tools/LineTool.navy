// Navy ~ 0.2-lite
// <ds>Draw Trendline [Click + Drag]</ds>

[OVERLAY name=LineTool, ctx=Canvas, verion=2.0.0, author=GPT4]

let line = null
let pressed = false
let state = 'idle'

init() {
    line = null
}

draw(ctx) {
    if (line) {
        line.draw(ctx)
    }
}

document.getElementById('idBtnToolLine')?.addEventListener('click', () => {
    pressed = true
})

function disableShift() {
    pressed = false
}

disableBtns = ["idBtnToolCursor", "idBtnToolBox", "idBtnToolFibo", "idBtnToolRange", "idBtnToolTrade"]
disableBtns.forEach(id => {
    document.getElementById(id)?.addEventListener('click', disableShift)
})

mousedown(event) {
    const layout = $core.layout

    if (!pressed) return

    if (state === 'idle') {
        if (event.button !== 0) return // only left click allowed

        //const t = $core.cursor.ti  // $core.cursor.time,
        const i = $core.cursor.ti
        const v = layout.y2value(event.layerY)

        const data = {
            type: 'segment',
            p1: [i, v],
            p2: [i, v],
            uuid: 'single-line'
        }

        line = new $lib.TrendLine($core, data, true)
        state = 'drawing'

    } else if (state === 'drawing') {
        state = 'finished'

    } else if (state === 'finished' && event.button === 2) {
        // and hover over Line
        if (line.hover) {
            state = 'idle'
            line = null
        }
    }

    $events.emitSpec('chart', 'update-layout')
    if (line) line.mousedown(event)
}

mouseup(event) {
    if (line) line.mouseup(event)
}

mousemove(event) {
    if (line) {
        line.mousemove(event)

        if (state === 'drawing') {
            const layout = $core.layout
            line.data.p2 = [
                $core.cursor.ti,
                layout.y2value(event.layerY)
            ]
        }
    }
}

legend() => null